generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WishlistStatus {
  draft
  published
  archived
}

enum EventType {
  baby_shower
  birthday
  wedding
  housewarming
  general
}

enum Locale {
  es
  en
}

enum Currency {
  PEN
  USD
  EUR
  MXN
  COP
  CLP
  ARS
}

enum GiftPriority {
  low
  medium
  high
}

enum GiftVisibilityStatus {
  available
  hidden
}

enum RsvpStatus {
  pending
  confirmed
  declined
}

enum RsvpResponseSource {
  guest
  owner
}

enum ImageOrientation {
  landscape
  portrait
  square
}

model User {
  id                      Int                        @id @default(autoincrement())
  clerkId                 String                     @unique
  email                   String                     @unique
  name                    String?
  imageUrl                String?
  wishlists               Wishlist[]
  memberships             WishlistMember[]           @relation("WishlistMemberUser")
  sentMemberships         WishlistMember[]           @relation("WishlistMemberInvitedBy")
  sentMemberInvitations   WishlistMemberInvitation[] @relation("WishlistMemberInvitationInvitedBy")
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
}

model Wishlist {
  id              String         @id @default(cuid())
  ownerId         Int
  owner           User           @relation(fields: [ownerId], references: [id])
  categories      Category[]
  gifts           Gift[]
  invites         Invite[]
  views           WishlistView[]
  images          WishlistImage[]
  members            WishlistMember[]
  memberInvitations  WishlistMemberInvitation[]
  title           String
  subtitle        String?
  slug            String         @unique
  eventType       EventType
  language        Locale         @default(es)
  currency        Currency       @default(PEN)
  welcomeMessage  String
  welcomeMessageAttribution String?
  thankYouMessage String?
  giftListMessage String?
  eventDate       DateTime?
  eventTime       String?
  endTime         String?
  rsvpDeadline    DateTime?
  eventLocation   String?
  dressCode       String?
  deliveryRecipientName String?
  deliveryDocumentId String?
  deliveryAddress String?
  deliveryPhone   String?
  themeId         String?
  layoutId        String?
  buttonStyle     String?
  headingFont     String?
  bodyFont        String?
  countdownVariant       String?
  welcomeMessageVariant  String?
  thankYouMessageVariant String?
  motifId         String?
  motifTreatment  String?
  motifPalette    String?
  showHowItWorks  Boolean        @default(true)
  status          WishlistStatus @default(draft)
  publishedAt     DateTime?
  archivedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([ownerId])
  @@index([ownerId, status])
}

model WishlistMember {
  id          String   @id @default(cuid())
  wishlistId  String
  wishlist    Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  userId      Int
  user        User     @relation("WishlistMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedById Int?
  invitedBy   User?    @relation("WishlistMemberInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@unique([wishlistId, userId])
  @@index([userId])
}

model WishlistMemberInvitation {
  id          String    @id @default(cuid())
  wishlistId  String
  wishlist    Wishlist  @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  email       String
  tokenHash   String    @unique
  invitedById Int?
  invitedBy   User?     @relation("WishlistMemberInvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  lastSentAt  DateTime?
  createdAt   DateTime  @default(now())

  @@unique([wishlistId, email])
  @@index([email])
}

model WishlistImage {
  id          String           @id @default(cuid())
  wishlistId  String
  wishlist    Wishlist         @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  url         String
  width       Int
  height      Int
  orientation ImageOrientation
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())

  @@index([wishlistId])
  @@index([wishlistId, sortOrder])
}

model Category {
  id         String   @id @default(cuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  gifts      Gift[]
  name       String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([wishlistId])
  @@index([wishlistId, sortOrder])
}

model Gift {
  id               String               @id @default(cuid())
  wishlistId       String
  wishlist         Wishlist             @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  categoryId       String?
  category         Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  purchases        Purchase[]
  name             String
  productUrl       String?
  imageUrl         String?
  storeName        String?
  size             String?
  priceAmount      Decimal?             @db.Decimal(10, 2)
  priceCurrency    Currency?
  quantityNeeded   Int                  @default(1)
  priority         GiftPriority         @default(medium)
  visibilityStatus GiftVisibilityStatus @default(available)
  publicNote       String?
  internalNote     String?
  sortOrder        Int                  @default(0)
  deletedAt        DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([wishlistId])
  @@index([wishlistId, sortOrder])
  @@index([categoryId])
}

model Invite {
  id            String             @id @default(cuid())
  wishlistId    String
  wishlist      Wishlist           @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  extraGuests   InviteExtraGuest[]
  views         WishlistView[]
  primaryName   String
  primaryEmail  String?
  primaryPhone  String?
  slug          String
  status        RsvpStatus         @default(pending)
  openedAt      DateTime?
  viewCount     Int                @default(0)
  lastViewedAt  DateTime?
  respondedAt   DateTime?
  responseSource RsvpResponseSource?
  responseLockedAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([wishlistId, slug])
  @@index([wishlistId])
}

model WishlistView {
  id          String   @id @default(cuid())
  wishlistId  String
  wishlist    Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  inviteId    String?
  invite      Invite?  @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  visitorHash String
  createdAt   DateTime @default(now())

  @@index([wishlistId, createdAt])
  @@index([inviteId, createdAt])
  @@index([wishlistId, visitorHash])
}

model InviteExtraGuest {
  id        String     @id @default(cuid())
  inviteId  String
  invite    Invite     @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  name      String?
  status    RsvpStatus @default(pending)
  sortOrder Int        @default(0)

  @@index([inviteId])
}

model Purchase {
  id            String    @id @default(cuid())
  giftId        String
  gift          Gift      @relation(fields: [giftId], references: [id], onDelete: Cascade)
  guestName     String
  guestEmail    String?
  guestPhone    String?
  message       String?
  quantity      Int       @default(1)
  undoTokenHash String?
  undoExpiresAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([giftId])
}
