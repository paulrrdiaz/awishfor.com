# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Example:
# SERVERVAR="foo"
# NEXT_PUBLIC_CLIENTVAR="bar"

# Neon Postgres — get the pooled connection string from https://console.neon.tech
DATABASE_URL="postgresql://..."

# Clerk authentication — get these from https://dashboard.clerk.com
# Also enable Google OAuth in the Clerk dashboard under User & Authentication > Social Connections
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard

# Clerk webhook signing secret — get from the Clerk dashboard after registering the webhook endpoint
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."

# UploadThing — get from https://uploadthing.com/dashboard
UPLOADTHING_TOKEN="..."

# Optional: server-only HMAC key for privacy-minimized public wishlist view
# analytics. Leave unset to keep first-party view recording disabled.
VIEW_ANALYTICS_HMAC_SECRET=""

# Optional: retries public product pages blocked by anti-bot protection.
# Create a Web Unlocker API zone at https://brightdata.com/products/web-unlocker
BRIGHT_DATA_API_KEY=""
BRIGHT_DATA_WEB_UNLOCKER_ZONE=""

# Optional: transactional email (invitations, notifications). Without these,
# sends are logged and skipped rather than delivered — the app runs fine without them.
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=""
# The verified sending address, e.g. "no-reply@awishfor.com"
EMAIL_FROM=""
# Optional: outside production, rewrites every recipient to this address instead
# of delivering to real users. Leave unset to log-and-skip instead of sending.
EMAIL_DEV_REDIRECT_TO=""

# Public app URL used for generating absolute links (e.g. share URLs)
NEXT_PUBLIC_APP_URL=http://localhost:4000

# PostHog product analytics — obtain the write-only project token from the
# US Cloud project settings. Leave unset to disable analytics capture.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Local dev server port and ngrok tunnel URL (for testing Clerk webhooks locally via `pnpm tunnel`)
PORT=4000
NGROK_URL="literally-dominant-seahorse.ngrok-free.app"
